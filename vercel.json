{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/overview", "destination": "/overview.html" },
    { "source": "/dashboard", "destination": "/overview.html" },
    { "source": "/console", "destination": "/overview.html" },
    { "source": "/diagnostics", "destination": "/settings.html" },
    { "source": "/documentation", "destination": "/docs.html" },
    { "source": "/api/(.*)", "destination": "/api/[...path]" }
  ]
}
