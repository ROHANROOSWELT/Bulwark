# ── KeeperHub (REQUIRED for any real execution) ──────────────────────────────
# Org API key from the KeeperHub app: Settings → Developer → API keys → Organisation keys
# NEVER commit the real value. BULWARK reads this from the environment only.
KEEPERHUB_API_KEY=kh_replace_me
KEEPERHUB_API_BASE=https://app.keeperhub.com

# ── Guardian agent LLM — Gemini 3.5 Flash-Lite (PRIMARY DRIVER via Google AI Studio)
# Get your key at: https://aistudio.google.com/apikey
# Without these, the underwriter runs in pure deterministic fallback mode.
GEMINI_API_KEY=your_google_ai_studio_key_here
BULWARK_LLM_API_KEY=your_google_ai_studio_key_here
BULWARK_LLM_MODEL=gemini-3.5-flash-lite
BULWARK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── Chain selection: 84532 = Base Sepolia (Aave V3 live market — PRIMARY)
# Alternatives: 11155111 = Ethereum Sepolia | 8453 = Base Mainnet | 1 = Ethereum Mainnet
BULWARK_CHAIN_ID=84532

# Optional public-RPC overrides for the independent verification path
# BULWARK_RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
# BULWARK_RPC_URL_BASE=https://mainnet.base.org

# ── Policy (deterministic bounds; the LLM can NEVER exceed these) ───────────
BULWARK_POLICY_MAX_USD_PER_ACTION=25
BULWARK_POLICY_HF_CRITICAL=1.35
BULWARK_POLICY_HF_TARGET=2.0

# ── Desk ─────────────────────────────────────────────────────────────────────
BULWARK_STORE_DIR=.bulwark
BULWARK_WEB_PORT=4567
BULWARK_DESK_BALANCE_USD=50000

# ── Operator Key (protects mutating API endpoints in production) ──────────────
# Used as: x-operator-key: <value>  OR  Authorization: Bearer <value>
# In local dev mode (no VERCEL env), mutating endpoints are open without this key.
BULWARK_OPERATOR_KEY=replace_with_your_secure_operator_key

# DEMO-ONLY: auto-approve proposed grants without a human action. Prints a loud warning.
# BULWARK_AUTO_APPROVE=1
